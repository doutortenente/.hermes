# Variáveis referenciadas pelo config.yaml.
# Copie para .env (gitignored) e preencha. NUNCA commite valores reais.

# 9Router (gateway LLM local, http://127.0.0.1:20128/v1)
NINEROUTER_KEY_DEFAULT=
NINEROUTER_KEY=
NINEROUTER_DASHBOARD_PASSWORD=

# Poolside
POOLSIDE_API_KEY=

# Dashboard Hermes (9119)
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=
DASHBOARD_AUTH_SECRET=

# Telegram
TELEGRAM_ALLOWED_CHATS=

# MCP servers
GITHUB_TOKEN=
POSTGRES_MCP_DSN=
CONTEXT7_API_KEY=

# Acesso remoto (skill remote-machine-access)
TAILSCALE_AUTH_KEY=
